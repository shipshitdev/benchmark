--- /dev/null
+++ b/components/LabelsFilter.tsx
@@ -0,0 +1,50 @@
+"use client";
+
+import { usePathname, useRouter, useSearchParams } from "next/navigation";
+import { startTransition, useOptimistic, type ChangeEvent } from "react";
+
+export function LabelsFilter({ labels }: { labels: string[] }) {
+  const router = useRouter();
+  const pathname = usePathname();
+  const searchParams = useSearchParams();
+  const [currentValue, setCurrentValue] = useOptimistic(searchParams.get("labels") ?? "");
+  const currentLabels = currentValue.split(",").filter(Boolean);
+
+  function handleChange(event: ChangeEvent<HTMLInputElement>) {
+    const { value, checked } = event.target;
+    const selected = checked
+      ? [...currentLabels, value]
+      : currentLabels.filter((label) => label !== value);
+    const params = new URLSearchParams(searchParams.toString());
+    if (selected.length > 0) {
+      params.set("labels", selected.join(","));
+    } else {
+      params.delete("labels");
+    }
+    startTransition(() => {
+      setCurrentValue(selected.join(","));
+      router.replace(`${pathname}?${params.toString()}`, { scroll: false });
+    });
+  }
+
+  return (
+    <fieldset data-testid="filter-labels" className="flex flex-col gap-1">
+      <legend className="text-sm font-medium">Labels</legend>
+      <div className="flex flex-wrap gap-3">
+        {labels.map((label) => (
+          <label key={label} className="flex items-center gap-1 text-sm">
+            <input
+              type="checkbox"
+              data-testid={`filter-label-option-${label}`}
+              value={label}
+              checked={currentLabels.includes(label)}
+              onChange={handleChange}
+              className="rounded border border-gray-300 dark:border-gray-600"
+            />
+            {label}
+          </label>
+        ))}
+      </div>
+    </fieldset>
+  );
+}
