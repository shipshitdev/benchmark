+++ b/issue-board.spec.ts
@@ -0,0 +1,71 @@
+import { expect, test } from "@playwright/test";
+
+const baseURL = `http://localhost:${process.env.PORT ?? "4174"}`;
+
+test("combines filters and preserves their controls after reloading a shared URL", async ({ page }) => {
+  await page.goto(`${baseURL}/?status=open&labels=bug,docs&assignee=Ava+Chen&q=SAFARI`);
+  await expect(page.getByTestId("issue-item-ISSUE-101")).toBeVisible();
+  await expect(page.locator('[data-testid^="issue-item-"]')).toHaveCount(1);
+  await page.reload();
+  await expect(page.getByRole("combobox", { name: "Status", exact: true })).toHaveValue("open");
+  await expect(page.getByRole("checkbox", { name: "bug", exact: true })).toBeChecked();
+  await expect(page.getByRole("checkbox", { name: "docs", exact: true })).toBeChecked();
+  await expect(page.getByRole("combobox", { name: "Assignee", exact: true })).toHaveValue("Ava Chen");
+  await expect(page.getByRole("textbox", { name: "Search titles" })).toHaveValue("SAFARI");
+  await expect(page.locator('[data-testid^="issue-item-"]')).toHaveCount(1);
+});
+
+test("labels use OR matching and clearing them preserves unrelated query keys", async ({ page }) => {
+  await page.goto(`${baseURL}/?labels=docs,feature&assignee=unassigned&keep=yes`);
+  await expect(page.locator('[data-testid^="issue-item-"]')).toHaveCount(7);
+  await page.getByTestId("filter-label-option-docs").uncheck();
+  await expect(page).toHaveURL(/labels=feature/);
+  await expect(page.locator('[data-testid^="issue-item-"]')).toHaveCount(5);
+  await page.getByTestId("filter-label-option-feature").uncheck();
+  await expect(page).not.toHaveURL(/labels=/);
+  await expect(page).toHaveURL(/assignee=unassigned/);
+  await expect(page).toHaveURL(/keep=yes/);
+  await page.getByTestId("filter-assignee").selectOption("");
+  await expect(page).not.toHaveURL(/assignee=/);
+  await expect(page.locator('[data-testid^="issue-item-"]')).toHaveCount(30);
+});
+
+test("empty combinations show the empty state and recover when search is cleared", async ({ page }) => {
+  await page.goto(`${baseURL}/?status=done&labels=feature&q=login`);
+  await expect(page.getByTestId("empty-state")).toBeVisible();
+  await expect(page.getByTestId("issue-list")).toHaveCount(0);
+  await page.getByTestId("filter-label-option-feature").uncheck();
+  await expect(page).not.toHaveURL(/labels=/);
+  await page.getByTestId("filter-search").fill("");
+  await expect(page).not.toHaveURL(/q=/);
+  await expect(page).toHaveURL(/status=done/);
+  await expect(page.getByTestId("issue-list")).toBeVisible();
+  await expect(page.getByTestId("empty-state")).toHaveCount(0);
+});
+
+test("all filters can be reached and operated with only the keyboard", async ({ page }) => {
+  await page.goto(baseURL);
+  await page.keyboard.press("Tab");
+  await expect(page.getByTestId("filter-status")).toBeFocused();
+  await page.keyboard.press("Tab");
+  await expect(page.getByRole("checkbox", { name: "bug", exact: true })).toBeFocused();
+  await page.keyboard.press("Space");
+  await expect(page).toHaveURL(/labels=bug/);
+  await page.keyboard.press("Tab");
+  await expect(page.getByRole("checkbox", { name: "docs", exact: true })).toBeFocused();
+  await page.keyboard.press("Space");
+  await expect(page).toHaveURL(/labels=bug%2Cdocs/);
+  for (let index = 0; index < 4; index++) {
+    await page.keyboard.press("Tab");
+  }
+  await expect(page.getByRole("combobox", { name: "Assignee", exact: true })).toBeFocused();
+  await page.keyboard.press("u");
+  await page.keyboard.press("Enter");
+  await expect(page).toHaveURL(/assignee=unassigned/);
+  await page.keyboard.press("Tab");
+  await expect(page.getByRole("textbox", { name: "Search titles" })).toBeFocused();
+  await page.keyboard.type("keyboard");
+  await expect(page.getByTestId("filter-search")).toHaveValue("keyboard");
+  await expect(page).toHaveURL(/q=keyboard/);
+  await expect(page.getByTestId("issue-item-ISSUE-108")).toBeVisible();
+});
diff --git a/lib/issues.ts b/lib/issues.ts
index 9f0851a..9f73857 100644
--- a/lib/issues.ts
+++ b/lib/issues.ts
@@ -49,20 +49,26 @@ export function filterByStatus(issues: Issue[], status: IssueStatus | null): Iss
   return issues.filter((issue) => issue.status === status);
 }
 
-// Extension points for filters that do not exist yet (see the fixture README for the
-// full data-testid and URL query-param convention each one should follow):
-//
-// filterByLabels(issues, labels: string[]): Issue[]
-//   An issue matches when `issue.labels` shares at least one entry with `labels`.
-//   An empty `labels` array means "no label filter applied" (return `issues` unchanged).
-//
-// filterByAssignee(issues, assignee: string | null): Issue[]
-//   `assignee === "unassigned"` matches issues where `issue.assignee === null`.
-//   `assignee === null` means "no assignee filter applied" (return `issues` unchanged).
-//
-// filterBySearch(issues, query: string): Issue[]
-//   Case-insensitive substring match of `query` against `issue.title`.
-//   An empty/blank `query` means "no search filter applied" (return `issues` unchanged).
-//
-// Each should be a small, pure function here in lib/issues.ts, mirroring filterByStatus,
-// and composed together by app/page.tsx the same way it already composes filterByStatus.
+export function filterByLabels(issues: Issue[], labels: string[]): Issue[] {
+  if (labels.length === 0) {
+    return issues;
+  }
+  return issues.filter((issue) => issue.labels.some((label) => labels.includes(label)));
+}
+
+export function filterByAssignee(issues: Issue[], assignee: string | null): Issue[] {
+  if (assignee === null) {
+    return issues;
+  }
+  return issues.filter((issue) =>
+    assignee === "unassigned" ? issue.assignee === null : issue.assignee === assignee,
+  );
+}
+
+export function filterBySearch(issues: Issue[], query: string): Issue[] {
+  if (query.trim() === "") {
+    return issues;
+  }
+  const search = query.toLowerCase();
+  return issues.filter((issue) => issue.title.toLowerCase().includes(search));
+}
