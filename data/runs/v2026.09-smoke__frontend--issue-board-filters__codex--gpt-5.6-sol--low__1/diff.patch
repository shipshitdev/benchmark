+++ b/components/LabelFilter.tsx
@@ -0,0 +1,44 @@
+"use client";
+
+import { usePathname, useRouter, useSearchParams } from "next/navigation";
+import type { ChangeEvent } from "react";
+
+export function LabelFilter({ labels }: { labels: string[] }) {
+  const router = useRouter();
+  const pathname = usePathname();
+  const searchParams = useSearchParams();
+  const selectedLabels = (searchParams.get("labels") ?? "").split(",").filter(Boolean);
+
+  function handleChange(event: ChangeEvent<HTMLInputElement>) {
+    const nextLabels = event.target.checked
+      ? [...selectedLabels, event.target.value]
+      : selectedLabels.filter((label) => label !== event.target.value);
+    const params = new URLSearchParams(searchParams.toString());
+    if (nextLabels.length > 0) {
+      params.set("labels", nextLabels.join(","));
+    } else {
+      params.delete("labels");
+    }
+    router.replace(`${pathname}?${params.toString()}`, { scroll: false });
+  }
+
+  return (
+    <fieldset data-testid="filter-labels" className="flex flex-col gap-1">
+      <legend className="text-sm font-medium">Labels</legend>
+      <div className="flex flex-wrap gap-x-3 gap-y-1">
+        {labels.map((label) => (
+          <label key={label} className="flex items-center gap-1 text-sm">
+            <input
+              type="checkbox"
+              value={label}
+              checked={selectedLabels.includes(label)}
+              onChange={handleChange}
+              data-testid={`filter-label-option-${label}`}
+            />
+            {label}
+          </label>
+        ))}
+      </div>
+    </fieldset>
+  );
+}
