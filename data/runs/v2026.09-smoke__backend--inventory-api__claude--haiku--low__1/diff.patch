+import { db } from "./db";
+import {
+  createErrorResponse,
+  ErrorResponse,
+  isValidCode,
+  isValidIdempotencyKey,
+  isValidMovementType,
+  isValidName,
+  isValidNote,
+  isValidQuantity,
+  isValidReorderThreshold,
+  isValidSku,
+  isValidUuid,
+  parsePaginationParams,
+  createPaginationResponse,
+} from "./validation";
+
+function generateUuid(): string {
+  return crypto.randomUUID();
+}
+
+function getCurrentTimestamp(): string {
+  return new Date().toISOString();
+}
+
+export async function handleRequest(req: Request): Promise<Response> {
+  const url = new URL(req.url);
+  const path = url.pathname;
+  const method = req.method;
+
+  // Health check
+  if (path === "/health" && method === "GET") {
+    return new Response(JSON.stringify({ status: "ok" }), {
+      status: 200,
+      headers: { "Content-Type": "application/json" },
+    });
+  }
+
+  // Products endpoints
+  if (path === "/products" && method === "POST") {
+    return handleCreateProduct(req);
+  }
+  if (path === "/products" && method === "GET") {
+    return handleListProducts(req);
+  }
+
+  const productIdMatch = path.match(/^\/products\/([^/]+)$/);
+  if (productIdMatch) {
+    const productId = productIdMatch[1];
+    if (method === "GET") {
+      return handleGetProduct(productId);
+    }
+    if (method === "PATCH") {
+      return handleUpdateProduct(productId, req);
+    }
+  }
+
+  // Warehouses endpoints
+  if (path === "/warehouses" && method === "POST") {
+    return handleCreateWarehouse(req);
+  }
+  if (path === "/warehouses" && method === "GET") {
+    return handleListWarehouses(req);
+  }
+
+  // Stock movements endpoint
+  if (path === "/stock-movements" && method === "POST") {
+    return handleCreateStockMovement(req);
+  }
+
+  // Low stock report
+  if (path === "/reports/low-stock" && method === "GET") {
+    return handleLowStockReport(req);
+  }
+
+  return new Response(JSON.stringify(createErrorResponse("not_found", "Not found")), {
+    status: 404,
+    headers: { "Content-Type": "application/json" },
+  });
+}
+
+async function handleCreateProduct(req: Request): Promise<Response> {
+  try {
+    const body = await req.json();
+    const errors: Array<{ field: string; issue: string }> = [];
+
+    if (typeof body.sku !== "string" || !isValidSku(body.sku)) {
+      errors.push({
+        field: "sku",
+        issue: "must be 1-64 characters, alphanumeric, dash, or underscore",
+      });
+    }
+    if (typeof body.name !== "string" || !isValidName(body.name)) {
+      errors.push({ field: "name", issue: "must be 1-200 characters" });
+    }
+    if (!isValidReorderThreshold(body.reorderThreshold)) {
+      errors.push({ field: "reorderThreshold", issue: "must be a non-negative integer" });
+    }
+
+    if (errors.length > 0) {
+      return new Response(
+        JSON.stringify(createErrorResponse("validation_error", "Validation failed", errors)),
+        { status: 400, headers: { "Content-Type": "application/json" } }
+      );
+    }
+
+    // Check if SKU already exists
+    const existing = db.prepare("SELECT id FROM products WHERE sku = ?").get(body.sku);
+    if (existing) {
+      return new Response(
+        JSON.stringify(
+          createErrorResponse("conflict", "A product with this sku already exists")
+        ),
+        { status: 409, headers: { "Content-Type": "application/json" } }
+      );
+    }
+
+    const id = generateUuid();
+    const now = getCurrentTimestamp();
+
+    db.prepare(
+      `INSERT INTO products (id, sku, name, reorderThreshold, createdAt, updatedAt)
+       VALUES (?, ?, ?, ?, ?, ?)`
+    ).run(id, body.sku, body.name, body.reorderThreshold, now, now);
+
+    const product = {
+      id,
+      sku: body.sku,
+      name: body.name,
+      reorderThreshold: body.reorderThreshold,
+      stock: 0,
+      createdAt: now,
+      updatedAt: now,
+    };
+
+    return new Response(JSON.stringify(product), {
+      status: 201,
+      headers: { "Content-Type": "application/json" },
+    });
+  } catch (e) {
+    console.error(e);
+    return new Response(
+      JSON.stringify(
+        createErrorResponse("internal_error", "Internal server error")
+      ),
+      { status: 500, headers: { "Content-Type": "application/json" } }
+    );
+  }
+}
+
+async function handleListProducts(req: Request): Promise<Response> {
+  try {
+    const url = new URL(req.url);
+    const paginationResult = parsePaginationParams(
+      Object.fromEntries(url.searchParams)
+    );
+    if ("error" in paginationResult) {
+      return new Response(JSON.stringify(paginationResult), {
+        status: 400,
+        headers: { "Content-Type": "application/json" },
+      });
+    }
+
+    const { page, pageSize } = paginationResult;
+    const offset = (page - 1) * pageSize;
+
+    const totalRow = db.prepare("SELECT COUNT(*) as count FROM products").get() as { count: number };
+    const total = totalRow.count;
+
+    const products = db
+      .prepare(
+        `SELECT id, sku, name, reorderThreshold, createdAt, updatedAt FROM products
+         ORDER BY createdAt ASC LIMIT ? OFFSET ?`
+      )
+      .all(pageSize, offset) as Array<{
+      id: string;
+      sku: string;
+      name: string;
+      reorderThreshold: number;
+      createdAt: string;
+      updatedAt: string;
+    }>;
+
+    const data = products.map((p) => {
+      const stock = calculateProductStock(p.id);
+      return { ...p, stock };
+    });
+
+    return new Response(
+      JSON.stringify({
+        data,
+        pagination: createPaginationResponse(page, pageSize, total),
+      }),
+      { status: 200, headers: { "Content-Type": "application/json" } }
+    );
+  } catch (e) {
+    console.error(e);
+    return new Response(
+      JSON.stringify(
+        createErrorResponse("internal_error", "Internal server error")
+      ),
+      { status: 500, headers: { "Content-Type": "application/json" } }
+    );
+  }
+}
+
+async function handleGetProduct(productId: string): Promise<Response> {
+  try {
+    if (!isValidUuid(productId)) {
+      return new Response(
+        JSON.stringify(createErrorResponse("not_found", "No product with this id")),
+        { status: 404, headers: { "Content-Type": "application/json" } }
+      );
+    }
+
+    const product = db
+      .prepare(
+        `SELECT id, sku, name, reorderThreshold, createdAt, updatedAt FROM products WHERE id = ?`
+      )
+      .get(productId) as {
+      id: string;
+      sku: string;
+      name: string;
+      reorderThreshold: number;
+      createdAt: string;
+      updatedAt: string;
+    } | undefined;
+
+    if (!product) {
+      return new Response(
+        JSON.stringify(createErrorResponse("not_found", "No product with this id")),
+        { status: 404, headers: { "Content-Type": "application/json" } }
+      );
+    }
+
+    const stock = calculateProductStock(productId);
+
+    return new Response(JSON.stringify({ ...product, stock }), {
+      status: 200,
+      headers: { "Content-Type": "application/json" },
+    });
+  } catch (e) {
+    console.error(e);
+    return new Response(
+      JSON.stringify(
+        createErrorResponse("internal_error", "Internal server error")
+      ),
+      { status: 500, headers: { "Content-Type": "application/json" } }
+    );
+  }
+}
+
+async function handleUpdateProduct(productId: string, req: Request): Promise<Response> {
+  try {
+    if (!isValidUuid(productId)) {
+      return new Response(
+        JSON.stringify(createErrorResponse("not_found", "No product with this id")),
+        { status: 404, headers: { "Content-Type": "application/json" } }
+      );
+    }
+
+    const body = await req.json();
+    const errors: Array<{ field: string; issue: string }> = [];
+
+    if (Object.keys(body).length === 0) {
+      errors.push({ field: "", issue: "at least one property must be provided" });
+    }
+
+    if (body.name !== undefined) {
+      if (typeof body.name !== "string" || !isValidName(body.name)) {
+        errors.push({ field: "name", issue: "must be 1-200 characters" });
+      }
+    }
+
+    if (body.reorderThreshold !== undefined) {
+      if (!isValidReorderThreshold(body.reorderThreshold)) {
+        errors.push({ field: "reorderThreshold", issue: "must be a non-negative integer" });
+      }
+    }
+
+    if (errors.length > 0) {
+      return new Response(
+        JSON.stringify(createErrorResponse("validation_error", "Validation failed", errors)),
+        { status: 400, headers: { "Content-Type": "application/json" } }
+      );
+    }
+
+    const product = db
+      .prepare(
+        `SELECT id, sku, name, reorderThreshold, createdAt, updatedAt FROM products WHERE id = ?`
+      )
+      .get(productId) as {
+      id: string;
+      sku: string;
+      name: string;
+      reorderThreshold: number;
+      createdAt: string;
+      updatedAt: string;
+    } | undefined;
+
+    if (!product) {
+      return new Response(
+        JSON.stringify(createErrorResponse("not_found", "No product with this id")),
+        { status: 404, headers: { "Content-Type": "application/json" } }
+      );
+    }
+
+    const name = body.name !== undefined ? body.name : product.name;
+    const reorderThreshold =
+      body.reorderThreshold !== undefined ? body.reorderThreshold : product.reorderThreshold;
+    const now = getCurrentTimestamp();
+
+    db.prepare(
+      `UPDATE products SET name = ?, reorderThreshold = ?, updatedAt = ? WHERE id = ?`
+    ).run(name, reorderThreshold, now, productId);
+
+    const stock = calculateProductStock(productId);
+
+    return new Response(
+      JSON.stringify({
+        id: productId,
+        sku: product.sku,
+        name,
+        reorderThreshold,
+        stock,
+        createdAt: product.createdAt,
+        updatedAt: now,
+      }),
+      { status: 200, headers: { "Content-Type": "application/json" } }
+    );
+  } catch (e) {
+    console.error(e);
+    return new Response(
+      JSON.stringify(
+        createErrorResponse("internal_error", "Internal server error")
+      ),
+      { status: 500, headers: { "Content-Type": "application/json" } }
+    );
+  }
+}
+
+async function handleCreateWarehouse(req: Request): Promise<Response> {
+  try {
+    const body = await req.json();
+    const errors: Array<{ field: string; issue: string }> = [];
+
+    if (typeof body.code !== "string" || !isValidCode(body.code)) {
+      errors.push({
+        field: "code",
+        issue: "must be 1-32 characters, alphanumeric, dash, or underscore",
+      });
+    }
+    if (typeof body.name !== "string" || !isValidName(body.name)) {
+      errors.push({ field: "name", issue: "must be 1-200 characters" });
+    }
+
+    if (errors.length > 0) {
+      return new Response(
+        JSON.stringify(createErrorResponse("validation_error", "Validation failed", errors)),
+        { status: 400, headers: { "Content-Type": "application/json" } }
+      );
+    }
+
+    // Check if code already exists
+    const existing = db.prepare("SELECT id FROM warehouses WHERE code = ?").get(body.code);
+    if (existing) {
+      return new Response(
+        JSON.stringify(
+          createErrorResponse("conflict", "A warehouse with this code already exists")
+        ),
