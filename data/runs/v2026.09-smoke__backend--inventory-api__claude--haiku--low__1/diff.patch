+
+async function handleCreateStockMovement(req: Request): Promise<Response> {
+  try {
+    const idempotencyKey = req.headers.get("Idempotency-Key");
+    if (!idempotencyKey) {
+      const errors = [{ field: "Idempotency-Key", issue: "header is required" }];
+      return new Response(
+        JSON.stringify(createErrorResponse("validation_error", "Validation failed", errors)),
+        { status: 400, headers: { "Content-Type": "application/json" } }
+      );
+    }
+
+    if (!isValidIdempotencyKey(idempotencyKey)) {
+      const errors = [{ field: "Idempotency-Key", issue: "must be 1-200 characters" }];
+      return new Response(
+        JSON.stringify(createErrorResponse("validation_error", "Validation failed", errors)),
+        { status: 400, headers: { "Content-Type": "application/json" } }
+      );
+    }
+
+    // Check if idempotency key already exists
+    const existing = db
+      .prepare("SELECT id, quantity FROM stock_movements WHERE idempotencyKey = ?")
+      .get(idempotencyKey) as { id: string; quantity: number } | undefined;
+
+    const body = await req.json();
+
+    if (existing) {
+      // Verify the request body matches
+      const storedMovement = db
+        .prepare(
+          `SELECT productId, warehouseId, type, quantity, note FROM stock_movements WHERE idempotencyKey = ?`
+        )
+        .get(idempotencyKey) as {
+        productId: string;
+        warehouseId: string;
+        type: string;
+        quantity: number;
+        note: string | null;
+      };
+
+      if (
+        storedMovement.productId !== body.productId ||
+        storedMovement.warehouseId !== body.warehouseId ||
+        storedMovement.type !== body.type ||
+        storedMovement.quantity !== body.quantity ||
+        storedMovement.note !== (body.note || null)
+      ) {
+        return new Response(
+          JSON.stringify(
+            createErrorResponse("conflict", "Idempotency-Key was reused with a different request body")
+          ),
+          { status: 409, headers: { "Content-Type": "application/json" } }
+        );
+      }
+
+      // Return the existing movement
+      const movement = db
+        .prepare(
+          `SELECT id, productId, warehouseId, type, quantity, note, idempotencyKey, resultingStock, createdAt
+           FROM stock_movements WHERE idempotencyKey = ?`
+        )
+        .get(idempotencyKey) as {
+        id: string;
+        productId: string;
+        warehouseId: string;
+        type: string;
+        quantity: number;
+        note: string | null;
+        idempotencyKey: string;
+        resultingStock: number;
+        createdAt: string;
+      };
+
+      return new Response(JSON.stringify(movement), {
+        status: 201,
+        headers: { "Content-Type": "application/json" },
+      });
+    }
+
+    // Validate request body
+    const errors: Array<{ field: string; issue: string }> = [];
+
+    if (typeof body.productId !== "string" || !isValidUuid(body.productId)) {
+      errors.push({ field: "productId", issue: "must be a valid UUID" });
+    }
+    if (typeof body.warehouseId !== "string" || !isValidUuid(body.warehouseId)) {
+      errors.push({ field: "warehouseId", issue: "must be a valid UUID" });
+    }
+    if (!isValidMovementType(body.type)) {
+      errors.push({ field: "type", issue: "must be one of: receipt, shipment, adjustment" });
+    }
+    if (!isValidQuantity(body.quantity, body.type)) {
+      if (body.type === "adjustment") {
+        errors.push({ field: "quantity", issue: "must be a nonzero integer" });
+      } else {
+        errors.push({ field: "quantity", issue: "must be a positive integer" });
+      }
+    }
+    if (!isValidNote(body.note)) {
+      errors.push({ field: "note", issue: "must be 0-500 characters" });
+    }
+
+    if (errors.length > 0) {
+      return new Response(
+        JSON.stringify(createErrorResponse("validation_error", "Validation failed", errors)),
+        { status: 400, headers: { "Content-Type": "application/json" } }
+      );
+    }
+
+    // Check if product exists
+    const product = db.prepare("SELECT id FROM products WHERE id = ?").get(body.productId);
+    if (!product) {
+      return new Response(
+        JSON.stringify(createErrorResponse("not_found", "Unknown productId or warehouseId")),
+        { status: 404, headers: { "Content-Type": "application/json" } }
+      );
+    }
+
+    // Check if warehouse exists
+    const warehouse = db.prepare("SELECT id FROM warehouses WHERE id = ?").get(body.warehouseId);
+    if (!warehouse) {
+      return new Response(
+        JSON.stringify(createErrorResponse("not_found", "Unknown productId or warehouseId")),
+        { status: 404, headers: { "Content-Type": "application/json" } }
+      );
+    }
+
+    // Calculate new stock
+    const currentStock = calculateProductStock(body.productId);
+    let newStock: number;
+
+    if (body.type === "receipt") {
+      newStock = currentStock + body.quantity;
+    } else if (body.type === "shipment") {
+      newStock = currentStock - body.quantity;
+    } else {
+      // adjustment
+      newStock = currentStock + body.quantity;
+    }
+
+    if (newStock < 0) {
+      return new Response(
+        JSON.stringify(
+          createErrorResponse("conflict", "The movement would take stock below zero")
+        ),
+        { status: 409, headers: { "Content-Type": "application/json" } }
+      );
+    }
+
+    const id = generateUuid();
+    const now = getCurrentTimestamp();
+
+    db.prepare(
+      `INSERT INTO stock_movements
+       (id, productId, warehouseId, type, quantity, note, idempotencyKey, resultingStock, createdAt)
+       VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?)`
+    ).run(
+      id,
+      body.productId,
+      body.warehouseId,
+      body.type,
+      body.quantity,
+      body.note || null,
+      idempotencyKey,
+      newStock,
+      now
+    );
+
+    return new Response(
+      JSON.stringify({
+        id,
+        productId: body.productId,
+        warehouseId: body.warehouseId,
+        type: body.type,
+        quantity: body.quantity,
+        note: body.note,
+        idempotencyKey,
+        resultingStock: newStock,
+        createdAt: now,
+      }),
+      { status: 201, headers: { "Content-Type": "application/json" } }
+    );
+  } catch (e) {
+    console.error(e);
+    return new Response(
+      JSON.stringify(
+        createErrorResponse("internal_error", "Internal server error")
+      ),
+      { status: 500, headers: { "Content-Type": "application/json" } }
+    );
+  }
+}
+
+async function handleLowStockReport(req: Request): Promise<Response> {
+  try {
+    const url = new URL(req.url);
+    const paginationResult = parsePaginationParams(
+      Object.fromEntries(url.searchParams)
+    );
+    if ("error" in paginationResult) {
+      return new Response(JSON.stringify(paginationResult), {
+        status: 400,
+        headers: { "Content-Type": "application/json" },
+      });
+    }
+
+    const { page, pageSize } = paginationResult;
+    const offset = (page - 1) * pageSize;
+
+    const totalRow = db
+      .prepare(
+        `SELECT COUNT(*) as count FROM products WHERE reorderThreshold > 0`
+      )
+      .get() as { count: number };
+    const total = totalRow.count;
+
+    const products = db
+      .prepare(
+        `SELECT id, sku, name, reorderThreshold FROM products
+         WHERE reorderThreshold > 0
+         ORDER BY createdAt ASC LIMIT ? OFFSET ?`
+      )
+      .all(pageSize, offset) as Array<{
+      id: string;
+      sku: string;
+      name: string;
+      reorderThreshold: number;
+    }>;
+
+    const data = products
+      .map((p) => {
+        const stock = calculateProductStock(p.id);
+        if (stock < p.reorderThreshold) {
+          return {
+            productId: p.id,
+            sku: p.sku,
+            name: p.name,
+            reorderThreshold: p.reorderThreshold,
+            stock,
+          };
+        }
+        return null;
+      })
+      .filter((item) => item !== null);
+
+    return new Response(
+      JSON.stringify({
+        data,
+        pagination: createPaginationResponse(page, pageSize, total),
+      }),
+      { status: 200, headers: { "Content-Type": "application/json" } }
+    );
+  } catch (e) {
+    console.error(e);
+    return new Response(
+      JSON.stringify(
+        createErrorResponse("internal_error", "Internal server error")
+      ),
+      { status: 500, headers: { "Content-Type": "application/json" } }
+    );
+  }
+}
+
+function calculateProductStock(productId: string): number {
+  const result = db
+    .prepare(
+      `SELECT COALESCE(SUM(CASE
+        WHEN type = 'receipt' THEN quantity
+        WHEN type = 'shipment' THEN -quantity
+        WHEN type = 'adjustment' THEN quantity
+        ELSE 0
+      END), 0) as stock FROM stock_movements WHERE productId = ?`
+    )
+    .get(productId) as { stock: number };
+  return Math.max(0, result.stock);
+}
