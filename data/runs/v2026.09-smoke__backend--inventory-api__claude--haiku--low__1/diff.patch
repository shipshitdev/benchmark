+
+    db.prepare(
+      `INSERT INTO warehouses (id, code, name, createdAt) VALUES (?, ?, ?, ?)`
+    ).run(id, body.code, body.name, now);
+
+    return new Response(
+      JSON.stringify({
+        id,
+        code: body.code,
+        name: body.name,
+        createdAt: now,
+      }),
+      { status: 201, headers: { "Content-Type": "application/json" } }
+    );
+  } catch (e) {
+    console.error(e);
+    return new Response(
+      JSON.stringify(
+        createErrorResponse("internal_error", "Internal server error")
+      ),
+      { status: 500, headers: { "Content-Type": "application/json" } }
+    );
+  }
+}
+
+async function handleListWarehouses(req: Request): Promise<Response> {
+  try {
+    const url = new URL(req.url);
+    const paginationResult = parsePaginationParams(
+      Object.fromEntries(url.searchParams)
+    );
+    if ("error" in paginationResult) {
