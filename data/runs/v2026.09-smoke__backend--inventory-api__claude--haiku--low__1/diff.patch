+interface ValidationError {
+  field: string;
+  issue: string;
+}
+
+export interface ErrorResponse {
+  error: {
+    code: "validation_error" | "not_found" | "conflict" | "internal_error";
+    message: string;
+    details?: ValidationError[];
+  };
+}
+
+export function createErrorResponse(
+  code: ErrorResponse["error"]["code"],
+  message: string,
+  details?: ValidationError[]
+): ErrorResponse {
+  return {
+    error: {
+      code,
+      message,
+      ...(details && details.length > 0 ? { details } : {}),
+    },
+  };
+}
+
+const UUID_PATTERN = /^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i;
+const SKU_PATTERN = /^[A-Za-z0-9_-]+$/;
+const CODE_PATTERN = /^[A-Za-z0-9_-]+$/;
+
+export function isValidUuid(id: string): boolean {
+  return UUID_PATTERN.test(id);
+}
+
+export function isValidSku(sku: string): boolean {
+  return sku.length >= 1 && sku.length <= 64 && SKU_PATTERN.test(sku);
+}
+
+export function isValidCode(code: string): boolean {
+  return code.length >= 1 && code.length <= 32 && CODE_PATTERN.test(code);
+}
+
+export function isValidName(name: string): boolean {
+  return name.length >= 1 && name.length <= 200;
+}
+
+export function isValidReorderThreshold(value: unknown): boolean {
+  return typeof value === "number" && Number.isInteger(value) && value >= 0;
+}
+
+export function isValidQuantity(value: unknown, type: string): boolean {
+  if (typeof value !== "number" || !Number.isInteger(value)) return false;
+  if (type === "adjustment") {
+    return value !== 0;
+  }
+  return value > 0;
+}
+
+export function isValidMovementType(type: unknown): boolean {
+  return type === "receipt" || type === "shipment" || type === "adjustment";
+}
+
+export function isValidNote(note: unknown): boolean {
+  return note === undefined || (typeof note === "string" && note.length <= 500);
+}
+
+export function isValidIdempotencyKey(key: string): boolean {
+  return key.length >= 1 && key.length <= 200;
+}
+
+export function parsePaginationParams(
+  query: Record<string, string | string[] | undefined>
+): { page: number; pageSize: number } | ErrorResponse {
+  const page = query.page ? parseInt(query.page as string, 10) : 1;
+  const pageSize = query.pageSize ? parseInt(query.pageSize as string, 10) : 20;
+
+  const errors: ValidationError[] = [];
+
+  if (isNaN(page) || page < 1) {
+    errors.push({ field: "page", issue: "must be an integer >= 1" });
+  }
+  if (isNaN(pageSize) || pageSize < 1 || pageSize > 100) {
+    errors.push({ field: "pageSize", issue: "must be an integer between 1 and 100" });
+  }
+
+  if (errors.length > 0) {
+    return createErrorResponse("validation_error", "Invalid pagination parameters", errors);
+  }
+
+  return { page, pageSize };
+}
+
+export function createPaginationResponse(page: number, pageSize: number, total: number) {
+  const totalPages = Math.ceil(total / pageSize);
+  return {
+    page,
+    pageSize,
+    total,
+    totalPages,
+  };
+}
