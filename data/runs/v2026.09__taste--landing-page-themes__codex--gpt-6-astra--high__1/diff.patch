+import { useId } from "react";
+
+export function Timer({
+  color = "sand",
+  className = "",
+  minutes = 25,
+}: {
+  color?: "sand" | "orange" | "blue" | "black";
+  className?: string;
+  minutes?: number;
+}) {
+  const id = useId().replaceAll(":", "");
+  const colors = {
+    sand: ["#e9e0cf", "#b5aa95", "#f8f4e9", "#ec754b"],
+    orange: ["#f17a42", "#a53d1c", "#f8e9c6", "#ed673a"],
+    blue: ["#8094b9", "#3d5478", "#f0f0e6", "#667fae"],
+    black: ["#454847", "#161a19", "#dddcc8", "#cbea6b"],
+  }[color];
+  return (
+    <svg
+      className={`timer ${className}`}
+      viewBox="0 0 520 520"
+      role="img"
+      aria-label={`Offhour ${color} aluminum timer set to ${minutes} minutes`}
+    >
+      <defs>
+        <linearGradient id={`${id}body`} x1="0" y1="0" x2="1" y2="1">
+          <stop stopColor={colors[0]} />
+          <stop offset=".5" stopColor={colors[1]} />
+          <stop offset="1" stopColor={colors[0]} />
+        </linearGradient>
+        <linearGradient id={`${id}rim`} x1="0" y1="0" x2=".7" y2="1">
+          <stop stopColor="#fff" stopOpacity=".8" />
+          <stop offset=".48" stopColor={colors[0]} />
+          <stop offset="1" stopColor={colors[1]} />
+        </linearGradient>
+        <radialGradient id={`${id}face`} cx=".35" cy=".2" r=".9">
+          <stop stopColor="#fffdf4" />
+          <stop offset="1" stopColor={colors[2]} />
+        </radialGradient>
+        <filter id={`${id}shadow`} x="-40%" y="-40%" width="190%" height="200%">
+          <feDropShadow
+            dx="12"
+            dy="26"
+            stdDeviation="20"
+            floodColor="#151710"
+            floodOpacity=".25"
+          />
+        </filter>
+      </defs>
+      <g filter={`url(#${id}shadow)`}>
+        <circle cx="260" cy="269" r="200" fill={`url(#${id}body)`} />
+        <circle cx="260" cy="252" r="199" fill={`url(#${id}rim)`} />
+        <circle cx="260" cy="252" r="186" fill={colors[1]} />
+        <circle cx="260" cy="249" r="181" fill={`url(#${id}face)`} />
+        <path
+          d={`M260 249 L260 85 A164 164 0 ${minutes > 30 ? 1 : 0} 1 ${260 + 164 * Math.sin((minutes / 60) * Math.PI * 2)} ${249 - 164 * Math.cos((minutes / 60) * Math.PI * 2)} Z`}
+          fill={colors[3]}
+        />
+        {Array.from({ length: 60 }, (_, i) => (
+          <line
+            key={i}
+            x1="260"
+            x2="260"
+            y1="88"
+            y2={i % 5 === 0 ? "108" : "96"}
+            stroke="#393a32"
+            strokeWidth={i % 5 === 0 ? 2 : 1}
+            transform={`rotate(${i * 6} 260 249)`}
+          />
+        ))}
+        {[0, 5, 10, 15, 20, 25, 30, 35, 40, 45, 50, 55].map((n) => (
+          <text
+            key={n}
+            x={260 + 128 * Math.sin((n / 60) * Math.PI * 2)}
+            y={254 - 128 * Math.cos((n / 60) * Math.PI * 2)}
+            fill="#34382f"
+            textAnchor="middle"
+            fontSize="14"
+            fontFamily="monospace"
+          >
+            {n === 0 ? "60" : n}
+          </text>
+        ))}
+        <circle
+          cx="260"
+          cy="249"
+          r="48"
+          fill={colors[2]}
+          stroke="#77766a"
+          strokeOpacity=".2"
+        />
+        <circle cx="260" cy="246" r="41" fill={`url(#${id}rim)`} />
+        <path
+          d="M260 216v-8"
+          stroke="#55574e"
+          strokeWidth="3"
+          strokeLinecap="round"
+        />
+        <text
+          x="260"
+          y="332"
+          fill="#46493e"
+          textAnchor="middle"
+          fontSize="10"
+          fontFamily="sans-serif"
+          letterSpacing="2.5"
+        >
+          OFFHOUR
+        </text>
+      </g>
+    </svg>
+  );
+}
+
+export function Logo({ star = false }: { star?: boolean }) {
+  return (
+    <a className="logo" href="/" aria-label="Offhour theme collection">
+      {star && <span aria-hidden="true">✳ </span>}offhour
+      <span className="logo-dot">®</span>
+    </a>
+  );
+}
+
+export function Faq({ items }: { items?: [string, string][] }) {
+  const questions: [string, string][] = items ?? [
+    [
+      "Does it need batteries or an app?",
+      "Neither. Offhour uses a wind-up mechanical movement. Turn the dial to set up to 60 minutes; the colored area gets smaller as time passes. Expect a soft mechanical tick.",
+    ],
+    [
+      "When will my Offhour arrive?",
+      "Our first small production run is planned for November 2026. This is a concept storefront; live preorders and payments are not open yet.",
+    ],
+    [
+      "What if it’s not for me?",
+      "Our planned policy is simple: cancel any time before shipping, or return it within 30 days of delivery. US shipping is included in the $48 price; any applicable tax will be shown at checkout when ordering opens.",
+    ],
+  ];
+  return (
+    <div className="faq-list">
+      {questions.map(([q, a]) => (
+        <details key={q}>
+          <summary>
+            {q}
+            <span aria-hidden="true">+</span>
+          </summary>
+          <p>{a}</p>
+        </details>
+      ))}
+    </div>
+  );
+}
