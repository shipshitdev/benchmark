+import { notFound } from "next/navigation";
+import type { Metadata } from "next";
+import {
+  ThemeOne,
+  ThemeTwo,
+  ThemeThree,
+  ThemeFour,
+  ThemeFive,
+} from "../../components/themes";
+
+const names = [
+  "A little room for focus",
+  "Take your time back",
+  "An hour, uninterrupted",
+  "Go make some time",
+  "Designed for deep work",
+];
+export function generateStaticParams() {
+  return [1, 2, 3, 4, 5].map((theme) => ({ theme: String(theme) }));
+}
+export async function generateMetadata({
+  params,
+}: {
+  params: Promise<{ theme: string }>;
+}): Promise<Metadata> {
+  const { theme } = await params;
+  return { title: `${names[Number(theme) - 1] ?? "Not found"} — Offhour` };
+}
+export default async function ThemePage({
+  params,
+}: {
+  params: Promise<{ theme: string }>;
+}) {
+  const { theme } = await params;
+  const pages = {
+    "1": ThemeOne,
+    "2": ThemeTwo,
+    "3": ThemeThree,
+    "4": ThemeFour,
+    "5": ThemeFive,
+  };
+  const Page = pages[theme as keyof typeof pages];
+  if (!Page) notFound();
+  return <Page />;
+}
