+"use client";
+
+import { useRef, useState, useEffect, useId } from "react";
+import { Timer } from "./product";
+
+export default function Preorder({
+  children = "Preorder — $48",
+  className = "",
+}: {
+  children?: React.ReactNode;
+  className?: string;
+}) {
+  const instanceId = useId();
+  const dialog = useRef<HTMLDialogElement>(null);
+  const [color, setColor] = useState<"sand" | "orange" | "blue">("sand");
+  const [saved, setSaved] = useState(false);
+  const [storageError, setStorageError] = useState(false);
+  useEffect(() => {
+    const element = dialog.current;
+    const unlock = () => {
+      document.body.style.overflow = "";
+    };
+    element?.addEventListener("close", unlock);
+    return () => {
+      element?.removeEventListener("close", unlock);
+      unlock();
+    };
+  }, []);
+  function open() {
+    setSaved(false);
+    setStorageError(false);
+    try {
+      const stored = JSON.parse(
+        localStorage.getItem("offhour-selection") ?? "null",
+      );
+      if (stored && ["sand", "orange", "blue"].includes(stored.color))
+        setColor(stored.color);
+    } catch {
+      /* A blocked or invalid saved preference does not prevent browsing. */
+    }
+    dialog.current?.showModal();
+    document.body.style.overflow = "hidden";
+  }
+  function save() {
+    try {
+      localStorage.setItem(
+        "offhour-selection",
+        JSON.stringify({ color, price: 48 }),
+      );
+      setSaved(true);
+    } catch {
+      setStorageError(true);
+    }
+  }
+  return (
+    <>
+      <button className={`cta ${className}`} onClick={open}>
+        {children}
+        <span aria-hidden="true">↗</span>
+      </button>
+      <dialog
+        ref={dialog}
+        className="order-dialog"
+        onClick={(event) => {
+          if (event.target === dialog.current) dialog.current.close();
+        }}
+        aria-labelledby={`${instanceId}-title`}
+      >
+        <button
+          className="dialog-close"
+          onClick={() => dialog.current?.close()}
+          aria-label="Close preorder preview"
+        >
+          ×
+        </button>
+        <div className="order-visual">
+          <Timer color={color} />
+          <span>FIRST EDITION / 60 MINUTES</span>
+        </div>
+        <div className="order-content">
+          <span className="eyebrow">PREORDER PREVIEW</span>
+          <h2 id={`${instanceId}-title`}>
+            An hour of
+            <br />
+            your own.
+          </h2>
+          <p>Offhour mechanical desk timer</p>
+          <div className="order-price">
+            $48 <small>US shipping included</small>
+          </div>
+          <fieldset>
+            <legend>
+              Choose your finish:{" "}
+              <strong>
+                {color === "sand"
+                  ? "Warm sand"
+                  : color === "orange"
+                    ? "Burnt orange"
+                    : "Slate blue"}
+              </strong>
+            </legend>
+            <div className="swatches">
+              {(["sand", "orange", "blue"] as const).map((c) => (
+                <label key={c} className={`swatch ${c}`}>
+                  <input
+                    type="radio"
+                    name={`${instanceId}-finish`}
+                    value={c}
+                    checked={color === c}
+                    onChange={() => {
+                      setColor(c);
+                      setSaved(false);
+                    }}
+                  />
+                  <span className="sr-only">{c}</span>
+                </label>
+              ))}
+            </div>
+          </fieldset>
+          <p className="preview-note">
+            A product concept, coming to life. Orders aren’t open yet. Save your
+            choice on this device to revisit it. No payment or personal details
+            needed.
+          </p>
+          <button className="save-selection" onClick={save}>
+            {saved ? "Selection saved ✓" : "Save my selection"}
+          </button>
+          <p className="save-status" role="status">
+            {saved
+              ? `Your ${color} Offhour is saved on this device. This is not a reservation or an order.`
+              : storageError
+                ? "Your browser couldn’t save this choice. Please allow local storage and try again."
+                : "Planned first shipment: November 2026"}
+          </p>
+        </div>
+      </dialog>
+    </>
+  );
+}
