diff --git a/tests/landing.spec.ts b/tests/landing.spec.ts
new file mode 100644
index 0000000..fc70af8
--- /dev/null
+++ b/tests/landing.spec.ts
@@ -0,0 +1,75 @@
+import { test, expect } from "@playwright/test";
+
+for (const width of [1440, 390, 320]) {
+  test(`all pages render and work at ${width}px`, async ({ page }) => {
+    await page.setViewportSize({ width, height: 900 });
+    const errors: string[] = [];
+    page.on("pageerror", (error) => errors.push(error.message));
+    page.on("console", (message) => {
+      if (message.type() === "error") errors.push(message.text());
+    });
+    for (const route of [
+      "/",
+      "/themes/1",
+      "/themes/2",
+      "/themes/3",
+      "/themes/4",
+      "/themes/5",
+    ]) {
+      const response = await page.goto(`http://localhost:4176${route}`);
+      expect(response?.status()).toBe(200);
+      await expect(page.locator("h1")).toBeVisible();
+      expect(
+        await page.evaluate(
+          () => document.documentElement.scrollWidth <= innerWidth,
+        ),
+      ).toBeTruthy();
+      if (route === "/") {
+        for (let i = 1; i <= 5; i++)
+          await expect(
+            page.locator(`.theme-card[href='/themes/${i}']`),
+          ).toBeVisible();
+      } else {
+        const action = page.locator(".site-nav .cta");
+        await expect(action).toBeInViewport();
+        await action.click();
+        const dialog = page.locator("dialog[open]");
+        await expect(dialog).toBeVisible();
+        await dialog
+          .getByRole("radio", { name: "orange", exact: true })
+          .check();
+        await dialog.getByRole("button", { name: "Save my selection" }).click();
+        await expect(dialog.getByRole("status")).toContainText(
+          "not a reservation or an order",
+        );
+        await page.keyboard.press("Escape");
+        await expect(dialog).toHaveCount(0);
+        await expect(action).toBeFocused();
+        await page.reload();
+        await action.click();
+        await expect(
+          page
+            .locator("dialog[open]")
+            .getByRole("radio", { name: "orange", exact: true }),
+        ).toBeChecked();
+        await page
+          .locator("dialog[open]")
+          .getByRole("button", { name: "Close preorder preview" })
+          .click();
+        const question = page.locator("details").first();
+        await question.locator("summary").click();
+        await expect(question).toHaveAttribute("open", "");
+      }
+      await page.screenshot({
+        path: `.qa/${width}-${route.replaceAll("/", "-") || "index"}.png`,
+        fullPage: true,
+      });
+    }
+    expect(errors).toEqual([]);
+  });
+}
+
+test("invalid theme returns 404", async ({ page }) => {
+  const response = await page.goto("http://localhost:4176/themes/6");
+  expect(response?.status()).toBe(404);
+});
