+test("migrate/start commands and idempotency survive a process restart", async () => {
+  mkdirSync(".test-data", { recursive: true });
+  const directory = mkdtempSync(`${process.cwd()}/.test-data/inventory-`);
+  const databasePath = `${directory}/inventory.sqlite`;
+  const probe = Bun.serve({ port: 0, fetch: () => new Response() });
+  const port = probe.port!;
+  await probe.stop(true);
+  const env = { ...process.env, DATABASE_PATH: databasePath, PORT: String(port) };
+  let processHandle: ReturnType<typeof Bun.spawn> | undefined;
+  async function start() {
+    processHandle = Bun.spawn(["bun", "run", "start"], { env, stdout: "ignore", stderr: "pipe" });
+    for (let attempt = 0; attempt < 100; attempt++) {
+      try {
+        const response = await fetch(`http://localhost:${port}/health`);
+        await response.text();
+        if (response.status === 200) return;
+      } catch { /* The process has not bound its port yet. */ }
+      if (processHandle.exitCode !== null) throw new Error(`Server exited with code ${processHandle.exitCode}`);
+      await Bun.sleep(20);
+    }
+    throw new Error("Server did not become ready");
+  }
+  async function stop() {
+    processHandle?.kill("SIGTERM");
+    if (processHandle) await processHandle.exited;
+    processHandle = undefined;
+  }
+  async function http(path: string, body?: unknown, key?: string) {
+    return fetch(`http://localhost:${port}${path}`, {
+      method: body === undefined ? "GET" : "POST",
+      headers: { "Content-Type": "application/json", ...(key ? { "Idempotency-Key": key } : {}) },
+      body: body === undefined ? undefined : JSON.stringify(body),
+    });
+  }
+  try {
+    for (let i = 0; i < 2; i++) {
+      const migration = Bun.spawn(["bun", "run", "migrate"], { env, stdout: "ignore", stderr: "pipe" });
+      expect(await migration.exited).toBe(0);
+    }
+    await start();
+    const p = await (await http("/products", { sku: "DURABLE", name: "Persistent", reorderThreshold: 2 })).text().then(JSON.parse);
+    const w = await (await http("/warehouses", { code: "MAIN", name: "Main" })).text().then(JSON.parse);
+    const input = { productId: p.id, warehouseId: w.id, type: "receipt", quantity: 7, note: "" };
+    const original = await (await http("/stock-movements", input, "durable-key")).text().then(JSON.parse);
+    expect(original.resultingStock).toBe(7);
+    await stop();
+    await start();
+    const replay = await http("/stock-movements", input, "durable-key");
+    expect(replay.status).toBe(201);
+    expect(await replay.text().then(JSON.parse)).toEqual(original);
+    expect((await (await http(`/products/${p.id}`)).text().then(JSON.parse)).stock).toBe(7);
+  } finally {
+    await stop();
+    rmSync(directory, { recursive: true, force: true });
+  }
+}, 15_000);
