diff --git a/src/app.ts b/src/app.ts
new file mode 100644
index 0000000..4c27563
--- /dev/null
+++ b/src/app.ts
@@ -0,0 +1,154 @@
+import { Database, SQLiteError } from "bun:sqlite";
+import { ApiError, movementCreate, pagination, productCreate, productUpdate, uuid, warehouseCreate } from "./validation";
+
+type Product = {
+  id: string; sku: string; name: string; reorderThreshold: number;
+  stock: number; createdAt: string; updatedAt: string;
+};
+type Movement = {
+  id: string; productId: string; warehouseId: string;
+  type: string; quantity: number; note: string | null;
+  idempotencyKey: string; resultingStock: number; createdAt: string;
+};
+
+function json(value: unknown, status = 200): Response {
+  return Response.json(value, { status });
+}
+
+function movementResponse(movement: Movement) {
+  const { note, ...required } = movement;
+  return note === null ? required : { ...required, note };
+}
+
+export function createHandler(db: Database): (request: Request) => Promise<Response> {
+  const getProduct = db.query<Product, [string]>("SELECT * FROM product_stock WHERE id = ?");
+  const getWarehouse = db.query("SELECT * FROM warehouses WHERE id = ?");
+  const getMovement = db.query<Movement, [string]>("SELECT * FROM stock_movements WHERE idempotencyKey = ?");
+
+  const recordMovement = db.transaction((input: Awaited<ReturnType<typeof movementCreate>>) => {
+    const previous = getMovement.get(input.idempotencyKey);
+    if (previous) {
+      if (previous.productId !== input.productId || previous.warehouseId !== input.warehouseId
+        || previous.type !== input.type || previous.quantity !== input.quantity || previous.note !== input.note) {
+        throw new ApiError(409, "Idempotency-Key was already used with a different request body");
+      }
+      return movementResponse(previous);
+    }
+    const product = getProduct.get(input.productId);
+    if (!product) throw new ApiError(404, "Product not found");
+    if (!getWarehouse.get(input.warehouseId)) throw new ApiError(404, "Warehouse not found");
+    const delta = input.type === "shipment" ? -input.quantity : input.quantity;
+    const resultingStock = product.stock + delta;
+    if (resultingStock < 0) throw new ApiError(409, "Movement would take stock below zero");
+    if (!Number.isSafeInteger(resultingStock)) throw new ApiError(409, "Resulting stock exceeds the supported integer range");
+    const movement: Movement = { ...input, id: crypto.randomUUID(), resultingStock, createdAt: new Date().toISOString() };
+    db.query(`INSERT INTO stock_movements
+      (id, productId, warehouseId, type, quantity, note, idempotencyKey, resultingStock, createdAt)
+      VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?)`)
+      .run(movement.id, movement.productId, movement.warehouseId, movement.type,
+        movement.quantity, movement.note, movement.idempotencyKey, resultingStock, movement.createdAt);
+    db.query("UPDATE products SET updatedAt = ? WHERE id = ?").run(movement.createdAt, movement.productId);
+    return movementResponse(movement);
+  });
+
+  const listQueries = {
+    "/products": {
+      count: db.query<{ total: number }, []>("SELECT COUNT(*) AS total FROM products"),
+      rows: db.query("SELECT * FROM product_stock ORDER BY createdAt, id LIMIT ? OFFSET ?"),
+    },
+    "/warehouses": {
+      count: db.query<{ total: number }, []>("SELECT COUNT(*) AS total FROM warehouses"),
+      rows: db.query("SELECT * FROM warehouses ORDER BY createdAt, id LIMIT ? OFFSET ?"),
+    },
+    "/reports/low-stock": {
+      count: db.query<{ total: number }, []>("SELECT COUNT(*) AS total FROM product_stock WHERE stock < reorderThreshold"),
+      rows: db.query(`SELECT id AS productId, sku, name, reorderThreshold, stock
+        FROM product_stock WHERE stock < reorderThreshold ORDER BY createdAt, id LIMIT ? OFFSET ?`),
+    },
+  };
+
+  async function route(request: Request): Promise<Response> {
+    const url = new URL(request.url);
+    const path = url.pathname;
+    const method = request.method;
+    const list = method === "GET" && Object.hasOwn(listQueries, path);
+    const { page, pageSize, offset } = pagination(url.searchParams, list);
+
+    if (method === "GET" && path === "/health") return json({ status: "ok" });
+
+    if (list) {
+      const queries = listQueries[path as keyof typeof listQueries];
+      const result = db.transaction(() => {
+        const total = queries.count.get()!.total;
+        const data = offset >= BigInt(total) ? [] : queries.rows.all(pageSize, Number(offset));
+        return { data, pagination: { page, pageSize, total, totalPages: Math.ceil(total / pageSize) } };
+      })();
+      return json(result);
+    }
+
+    if (path === "/products" && method === "POST") {
+      const input = await productCreate(request);
+      const now = new Date().toISOString();
+      const id = crypto.randomUUID();
+      db.query("INSERT INTO products (id, sku, name, reorderThreshold, createdAt, updatedAt) VALUES (?, ?, ?, ?, ?, ?)")
+        .run(id, input.sku, input.name, input.reorderThreshold, now, now);
+      return json(getProduct.get(id), 201);
+    }
+
+    const productPath = /^\/products\/([^/]+)$/.exec(path);
+    if (productPath && (method === "GET" || method === "PATCH")) {
+      let decoded: string;
+      try {
+        decoded = decodeURIComponent(productPath[1]!);
+      } catch {
+        throw new ApiError(400, "Request validation failed", [{ field: "productId", issue: "Must be a UUID" }]);
+      }
+      const id = uuid(decoded, "productId");
+      if (method === "GET") {
+        const product = getProduct.get(id);
+        if (!product) throw new ApiError(404, "Product not found");
+        return json(product);
+      }
+      const input = await productUpdate(request);
+      const updated = db.transaction(() => {
+        if (!getProduct.get(id)) throw new ApiError(404, "Product not found");
+        db.query(`UPDATE products SET name = COALESCE(?, name),
+          reorderThreshold = COALESCE(?, reorderThreshold), updatedAt = ? WHERE id = ?`)
+          .run(input.name ?? null, input.reorderThreshold ?? null, new Date().toISOString(), id);
+        return getProduct.get(id);
+      }).immediate();
+      return json(updated);
+    }
+
+    if (path === "/warehouses" && method === "POST") {
+      const input = await warehouseCreate(request);
+      const warehouse = { id: crypto.randomUUID(), ...input, createdAt: new Date().toISOString() };
+      db.query("INSERT INTO warehouses (id, code, name, createdAt) VALUES (?, ?, ?, ?)")
+        .run(warehouse.id, warehouse.code, warehouse.name, warehouse.createdAt);
+      return json(warehouse, 201);
+    }
+
+    if (path === "/stock-movements" && method === "POST") {
+      const input = await movementCreate(request);
+      return json(recordMovement.immediate(input), 201);
+    }
+
+    throw new ApiError(404, "Route not found");
+  }
+
+  return async (request) => {
+    try {
+      return await route(request);
+    } catch (error) {
+      if (error instanceof ApiError) {
+        const code = error.status === 400 ? "validation_error" : error.status === 404 ? "not_found" : "conflict";
+        return json({ error: { code, message: error.message, ...(error.details ? { details: error.details } : {}) } }, error.status);
+      }
+      if (error instanceof SQLiteError && error.code === "SQLITE_CONSTRAINT_UNIQUE") {
+        return json({ error: { code: "conflict", message: "A record with this sku or code already exists" } }, 409);
+      }
+      console.error(error);
+      return json({ error: { code: "internal_error", message: "An unexpected error occurred" } }, 500);
+    }
+  };
+}
