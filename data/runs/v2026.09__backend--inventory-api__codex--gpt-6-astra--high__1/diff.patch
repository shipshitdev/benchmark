+++ b/src/server.ts
@@ -0,0 +1,23 @@
+import { createHandler } from "./app";
+import { migrate, openDatabase } from "./database";
+
+const value = process.env.PORT;
+const port = Number(value);
+if (!value || !/^\d+$/.test(value) || !Number.isInteger(port) || port < 1 || port > 65535) {
+  throw new Error("PORT must be an integer between 1 and 65535");
+}
+
+const db = openDatabase();
+migrate(db);
+const server = Bun.serve({ port, hostname: "0.0.0.0", fetch: createHandler(db) });
+console.log(`Inventory API listening on port ${server.port}`);
+
+let stopping = false;
+async function shutdown() {
+  if (stopping) return;
+  stopping = true;
+  await server.stop();
+  db.close();
+}
+process.on("SIGINT", shutdown);
+process.on("SIGTERM", shutdown);
diff --git a/src/validation.ts b/src/validation.ts
new file mode 100644
index 0000000..45ec877
--- /dev/null
+++ b/src/validation.ts
@@ -0,0 +1,116 @@
+export type Detail = { field: string; issue: string };
+export class ApiError extends Error {
+  constructor(
+    public status: 400 | 404 | 409,
+    message: string,
+    public details?: Detail[],
+  ) {
+    super(message);
+  }
+}
+
+function invalid(field: string, issue: string): never {
+  throw new ApiError(400, "Request validation failed", [{ field, issue }]);
+}
+
+export function uuid(value: unknown, field: string): string {
+  if (typeof value !== "string" || !/^[\da-f]{8}-[\da-f]{4}-[\da-f]{4}-[\da-f]{4}-[\da-f]{12}$/i.test(value)) {
+    invalid(field, "Must be a UUID");
+  }
+  return value;
+}
+
+function string(value: unknown, field: string, min: number, max: number, pattern?: RegExp): string {
+  if (typeof value !== "string") invalid(field, "Must be a string");
+  const length = [...value].length;
+  if (length < min || length > max) invalid(field, `Must contain ${min} to ${max} characters`);
+  if (pattern && !pattern.test(value)) invalid(field, "Must contain only letters, digits, underscores, or hyphens");
+  return value;
+}
+
+function integer(value: unknown, field: string, min?: number): number {
+  if (typeof value !== "number" || !Number.isSafeInteger(value)) invalid(field, "Must be a safe integer");
+  if (min !== undefined && value < min) invalid(field, `Must be at least ${min}`);
+  return value;
+}
+
+async function body(request: Request, allowed: string[]): Promise<Record<string, unknown>> {
+  let value: unknown;
+  try {
+    value = await request.json();
+  } catch {
+    invalid("body", "Must contain valid JSON");
+  }
+  if (value === null || typeof value !== "object" || Array.isArray(value)) invalid("body", "Must be an object");
+  for (const key of Object.keys(value)) {
+    if (!allowed.includes(key)) invalid(key, "Unknown property");
+  }
+  return value as Record<string, unknown>;
+}
+
+export async function productCreate(request: Request) {
+  const value = await body(request, ["sku", "name", "reorderThreshold"]);
+  return {
+    sku: string(value.sku, "sku", 1, 64, /^[A-Za-z0-9_-]+$/),
+    name: string(value.name, "name", 1, 200),
+    reorderThreshold: integer(value.reorderThreshold, "reorderThreshold", 0),
+  };
+}
+
+export async function productUpdate(request: Request) {
+  const value = await body(request, ["name", "reorderThreshold"]);
+  if (Object.keys(value).length === 0) invalid("body", "At least one property is required");
+  return {
+    name: Object.hasOwn(value, "name") ? string(value.name, "name", 1, 200) : undefined,
+    reorderThreshold: Object.hasOwn(value, "reorderThreshold")
+      ? integer(value.reorderThreshold, "reorderThreshold", 0) : undefined,
+  };
+}
+
+export async function warehouseCreate(request: Request) {
+  const value = await body(request, ["code", "name"]);
+  return {
+    code: string(value.code, "code", 1, 32, /^[A-Za-z0-9_-]+$/),
+    name: string(value.name, "name", 1, 200),
+  };
+}
+
+export async function movementCreate(request: Request) {
+  const idempotencyKey = string(request.headers.get("Idempotency-Key"), "Idempotency-Key", 1, 200);
+  const value = await body(request, ["productId", "warehouseId", "type", "quantity", "note"]);
+  const productId = uuid(value.productId, "productId");
+  const warehouseId = uuid(value.warehouseId, "warehouseId");
+  if (value.type !== "receipt" && value.type !== "shipment" && value.type !== "adjustment") {
+    invalid("type", "Must be receipt, shipment, or adjustment");
+  }
+  const quantity = integer(value.quantity, "quantity", value.type === "adjustment" ? undefined : 1);
+  if (quantity === 0) invalid("quantity", "Must be nonzero");
+  return {
+    productId,
+    warehouseId,
+    type: value.type,
+    quantity,
+    note: Object.hasOwn(value, "note") ? string(value.note, "note", 0, 500) : null,
+    idempotencyKey,
+  };
+}
+
+export function pagination(params: URLSearchParams, list: boolean) {
+  for (const key of params.keys()) {
+    if (!list || (key !== "page" && key !== "pageSize")) invalid(key, "Unknown query parameter");
+  }
+  function read(key: string, fallback: number, max = Number.MAX_SAFE_INTEGER) {
+    const values = params.getAll(key);
+    if (!values.length) return fallback;
+    const value = values[0]!;
+    if (values.length !== 1 || !/^\d+$/.test(value)) invalid(key, "Must be a single positive integer");
+    const number = Number(value);
+    if (!Number.isSafeInteger(number) || number < 1 || number > max) invalid(key, `Must be between 1 and ${max}`);
+    return number;
+  }
+  const page = read("page", 1);
+  const pageSize = read("pageSize", 20, 100);
+  // Offsets beyond SQLite's integer range are necessarily past all stored rows.
+  const offset = BigInt(page - 1) * BigInt(pageSize);
+  return { page, pageSize, offset };
+}
diff --git a/tests/inventory.test.ts b/tests/inventory.test.ts
