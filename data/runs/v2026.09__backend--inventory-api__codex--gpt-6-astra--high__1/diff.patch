+      });
+    }
+    const receipts = await Promise.all(Array.from({ length: 12 }, () => post(input, "shared")));
+    const movements = await Promise.all(receipts.map((r) => { expect(r.status).toBe(201); return r.text().then(JSON.parse); }));
+    expect(new Set(movements.map((m) => m.id)).size).toBe(1);
+    const shipments = await Promise.all(Array.from({ length: 10 }, (_, i) => post({ ...input, type: "shipment", quantity: 3 }, `ship-${i}`)));
+    expect(shipments.filter((r) => r.status === 201)).toHaveLength(3);
