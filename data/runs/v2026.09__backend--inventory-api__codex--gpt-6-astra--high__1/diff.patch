+++ b/tests/inventory.test.ts
@@ -0,0 +1,249 @@
+import { afterEach, beforeEach, expect, test } from "bun:test";
+import { Database } from "bun:sqlite";
+import { mkdirSync, mkdtempSync, rmSync } from "node:fs";
+import { createHandler } from "../src/app";
+import { migrate, openDatabase } from "../src/database";
+
+let db: Database;
+let handler: ReturnType<typeof createHandler>;
+
+beforeEach(() => {
+  db = openDatabase(":memory:");
+  migrate(db);
+  handler = createHandler(db);
+});
+afterEach(() => db.close());
+
+async function request(path: string, method = "GET", body?: unknown, key?: string) {
+  return handler(new Request(`http://localhost${path}`, {
+    method,
+    headers: { "Content-Type": "application/json", ...(key === undefined ? {} : { "Idempotency-Key": key }) },
+    body: body === undefined ? undefined : JSON.stringify(body),
+  }));
+}
+
+async function product(sku = "SKU-1", reorderThreshold = 5) {
+  const response = await request("/products", "POST", { sku, name: "Product", reorderThreshold });
+  expect(response.status).toBe(201);
+  return response.text().then(JSON.parse);
+}
+
+async function warehouse(code = "WH-1") {
+  const response = await request("/warehouses", "POST", { code, name: "Warehouse" });
+  expect(response.status).toBe(201);
+  return response.text().then(JSON.parse);
+}
+
+async function fixture() {
+  const p = await product();
+  const w = await warehouse();
+  return { productId: p.id, warehouseId: w.id, type: "receipt", quantity: 10 };
+}
+
+async function expectError(response: Response, status: number, code: string) {
+  expect(response.status).toBe(status);
+  const value = await response.text().then(JSON.parse);
+  expect(Object.keys(value)).toEqual(["error"]);
+  expect(value.error.code).toBe(code);
+  expect(typeof value.error.message).toBe("string");
+  expect(Object.keys(value.error).every((key) => ["code", "message", "details"].includes(key))).toBe(true);
+  if (value.error.details) {
+    expect(value.error.details.length).toBeGreaterThan(0);
+    for (const detail of value.error.details) {
+      expect(typeof detail.field).toBe("string");
+      expect(typeof detail.issue).toBe("string");
+    }
+  }
+}
+
+test("health and product create/get/patch with zero threshold and duplicate SKU", async () => {
+  expect((await request("/health")).status).toBe(200);
+  const p = await product();
+  expect(p.stock).toBe(0);
+  expect(p.id).toMatch(/^[a-f\d-]{36}$/);
+  expect(Number.isNaN(Date.parse(p.createdAt))).toBe(false);
+  expect(await (await request(`/products/${p.id}`)).text().then(JSON.parse)).toEqual(p);
+  const updated = await request(`/products/${p.id}`, "PATCH", { name: "Updated", reorderThreshold: 0 });
+  expect(updated.status).toBe(200);
+  expect(await updated.text().then(JSON.parse)).toMatchObject({ ...p, name: "Updated", reorderThreshold: 0, updatedAt: expect.any(String) });
+  await expectError(await request("/products", "POST", { sku: p.sku, name: "Duplicate", reorderThreshold: 1 }), 409, "conflict");
+  await expectError(await request(`/products/${crypto.randomUUID()}`), 404, "not_found");
+  await expectError(await request(`/products/${crypto.randomUUID()}`, "PATCH", { name: "Unknown" }), 404, "not_found");
+});
+
+test("warehouses are unique and all lists paginate, including empty and out-of-range pages", async () => {
+  for (const path of ["/products", "/warehouses", "/reports/low-stock"]) {
+    expect(await (await request(path)).text().then(JSON.parse)).toEqual({ data: [], pagination: { page: 1, pageSize: 20, total: 0, totalPages: 0 } });
+  }
+  for (let i = 0; i < 3; i++) {
+    await product(`SKU-${i}`);
+    await warehouse(`WH-${i}`);
+  }
+  for (const path of ["/products", "/warehouses", "/reports/low-stock"]) {
+    const first = await (await request(`${path}?pageSize=2`)).text().then(JSON.parse);
+    const second = await (await request(`${path}?page=2&pageSize=2`)).text().then(JSON.parse);
+    expect(first.data).toHaveLength(2);
+    expect(second.data).toHaveLength(1);
+    expect(second.pagination).toEqual({ page: 2, pageSize: 2, total: 3, totalPages: 2 });
+    expect(new Set([...first.data, ...second.data].map((row) => row.id ?? row.productId)).size).toBe(3);
