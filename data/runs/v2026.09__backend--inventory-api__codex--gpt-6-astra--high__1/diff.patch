@@ -0,0 +1,14 @@
+import { Database } from "bun:sqlite";
+import { readFileSync } from "node:fs";
+
+export function openDatabase(path = process.env.DATABASE_PATH): Database {
+  if (!path) throw new Error("DATABASE_PATH is required");
+  const db = new Database(path, { create: true, strict: true });
+  db.exec("PRAGMA foreign_keys = ON; PRAGMA busy_timeout = 5000; PRAGMA journal_mode = WAL;");
+  return db;
+}
+
+export function migrate(db: Database): void {
+  const sql = readFileSync(new URL("../migrations/001_inventory.sql", import.meta.url), "utf8");
+  db.transaction(() => db.exec(sql)).immediate();
+}
