new file mode 100644
index 0000000..b8bfb7c
--- /dev/null
+++ b/migrations/001_inventory.sql
@@ -0,0 +1,42 @@
+CREATE TABLE IF NOT EXISTS products (
+  id TEXT PRIMARY KEY,
+  sku TEXT NOT NULL UNIQUE,
+  name TEXT NOT NULL,
+  reorderThreshold INTEGER NOT NULL CHECK (reorderThreshold >= 0),
+  createdAt TEXT NOT NULL,
+  updatedAt TEXT NOT NULL
+);
+
+CREATE TABLE IF NOT EXISTS warehouses (
+  id TEXT PRIMARY KEY,
+  code TEXT NOT NULL UNIQUE,
+  name TEXT NOT NULL,
+  createdAt TEXT NOT NULL
+);
+
+CREATE TABLE IF NOT EXISTS stock_movements (
+  id TEXT PRIMARY KEY,
+  productId TEXT NOT NULL REFERENCES products(id),
+  warehouseId TEXT NOT NULL REFERENCES warehouses(id),
+  type TEXT NOT NULL CHECK (type IN ('receipt', 'shipment', 'adjustment')),
+  quantity INTEGER NOT NULL CHECK (
+    (type IN ('receipt', 'shipment') AND quantity > 0)
+    OR (type = 'adjustment' AND quantity != 0)
+  ),
+  note TEXT,
+  idempotencyKey TEXT NOT NULL UNIQUE,
+  resultingStock INTEGER NOT NULL CHECK (resultingStock >= 0),
+  createdAt TEXT NOT NULL
+);
+
+CREATE INDEX IF NOT EXISTS stock_movements_product ON stock_movements(productId);
+CREATE INDEX IF NOT EXISTS stock_movements_warehouse ON stock_movements(warehouseId);
+
+CREATE VIEW IF NOT EXISTS product_stock AS
+SELECT p.*, COALESCE(s.stock, 0) AS stock
+FROM products p
+LEFT JOIN (
+  SELECT productId, SUM(CASE WHEN type = 'shipment' THEN -quantity ELSE quantity END) AS stock
+  FROM stock_movements
+  GROUP BY productId
+) s ON s.productId = p.id;
