+:root { --ink: #161512; --paper: #ece8dc; --signal: #f04424; --acid: #d5ed52; }
+* { box-sizing: border-box; }
+html { scroll-behavior: smooth; }
+body { margin: 0; background: var(--paper); color: var(--ink); font-family: "Courier New", Courier, monospace; }
