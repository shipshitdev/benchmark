-}
+.hero-shell { min-height: 100svh; overflow: hidden; position: relative; display: flex; flex-direction: column; background: linear-gradient(90deg, transparent calc(50% - .5px), rgba(22,21,18,.1) 50%, transparent calc(50% + .5px)), var(--paper); }
+.noise { position: fixed; inset: 0; z-index: 10; pointer-events: none; opacity: .055; background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.8'/%3E%3C/svg%3E"); }
+.topbar { height: 92px; display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 24px; padding: 0 clamp(22px, 4vw, 64px); border-bottom: 1px solid var(--ink); }
+.wordmark { width: max-content; display: flex; align-items: center; gap: 12px; font-weight: 700; letter-spacing: -.06em; }
+.wordmark-block { display: grid; place-items: center; width: 37px; height: 37px; background: var(--ink); color: var(--paper); font-size: 12px; letter-spacing: -.1em; transform: rotate(-3deg); }
+.nav-note { margin: 0; font-size: 9px; line-height: 1.45; text-align: center; text-transform: uppercase; letter-spacing: .13em; }
+.live-pill { justify-self: end; display: flex; align-items: center; gap: 9px; padding: 10px 11px 10px 13px; border: 1px solid var(--ink); border-radius: 99px; background: var(--acid); font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: .08em; transition: transform 180ms ease, box-shadow 180ms ease; }
+.live-pill:hover { transform: translate(-2px, -2px); box-shadow: 3px 3px 0 var(--ink); }
+.live-arrow { font-size: 15px; line-height: 0; }
+.live-dot { width: 7px; height: 7px; border-radius: 50%; background: var(--signal); animation: pulse 1.4s ease-out infinite; }
+
+.hero { width: 100%; max-width: 1600px; margin: auto; padding: clamp(32px, 5vh, 68px) clamp(22px, 4vw, 64px) clamp(34px, 6vh, 78px); flex: 1; display: flex; flex-direction: column; justify-content: center; }
+.eyebrow { display: flex; align-items: center; gap: 15px; width: min(500px, 80%); margin-bottom: clamp(18px, 3vh, 36px); font-size: 9px; font-weight: 700; text-transform: uppercase; letter-spacing: .14em; }
+.eyebrow-line { height: 1px; background: var(--ink); flex: 1; }
+.headline-wrap { position: relative; }
+h1 { margin: 0; max-width: 1180px; font-family: Impact, Haettenschweiler, "Arial Narrow Bold", sans-serif; font-size: clamp(74px, 12.2vw, 184px); font-weight: 900; line-height: .77; letter-spacing: -.068em; text-transform: uppercase; }
+.scribble { position: relative; color: var(--signal); font-family: Georgia, "Times New Roman", serif; font-style: italic; font-weight: 400; letter-spacing: -.09em; text-transform: lowercase; }
+.scribble::after { content: ""; position: absolute; left: -1%; right: -3%; bottom: 4%; height: 7px; background: var(--signal); clip-path: polygon(0 40%, 23% 20%, 49% 45%, 73% 10%, 100% 55%, 100% 80%, 73% 50%, 48% 82%, 20% 58%, 0 90%); }
+.asterisk { display: inline-block; width: .49em; color: var(--signal); font-family: Georgia, serif; font-size: .75em; text-align: center; vertical-align: .1em; animation: rotate 12s linear infinite; }
+.stamp { position: absolute; top: 4%; right: 1%; width: clamp(80px, 9vw, 128px); aspect-ratio: 1; display: flex; flex-direction: column; justify-content: center; align-items: center; border: 2px solid var(--signal); border-radius: 50%; color: var(--signal); font-weight: 700; font-size: clamp(10px, 1vw, 14px); letter-spacing: .14em; line-height: 1.4; transform: rotate(9deg); }
+.stamp::before, .stamp::after { content: "✦"; position: absolute; font-size: 10px; }
+.stamp::before { top: 7px; } .stamp::after { bottom: 7px; }
+
+.hero-lower { display: grid; grid-template-columns: 1fr minmax(420px, 580px) 1fr; align-items: end; gap: 42px; margin-top: clamp(42px, 7vh, 82px); }
+.coordinates { display: flex; flex-direction: column; font-size: 9px; line-height: 1.7; letter-spacing: .1em; }
+.hero-copy p { margin: 0; font-family: Georgia, "Times New Roman", serif; font-size: clamp(18px, 1.6vw, 24px); line-height: 1.35; letter-spacing: -.025em; }
+.actions { display: flex; gap: 10px; margin-top: 27px; }
+.button { min-height: 52px; display: inline-flex; align-items: center; justify-content: center; gap: 25px; padding: 0 20px; border: 1px solid var(--ink); font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: .07em; transition: transform 180ms ease, box-shadow 180ms ease, background 180ms ease; }
+.button svg { width: 18px; height: 18px; flex: 0 0 auto; }
+.button-primary { background: var(--ink); color: var(--paper); }
+.button-secondary { background: transparent; }
+.button:hover { transform: translate(-3px, -3px); box-shadow: 4px 4px 0 var(--signal); }
+.button-primary:hover { background: var(--signal); }
+.side-note { justify-self: end; display: flex; align-items: stretch; gap: 14px; }
+.side-note-rule { width: 5px; background: var(--signal); }
+.side-note p { margin: 0; font-size: 9px; line-height: 1.55; text-transform: uppercase; letter-spacing: .08em; }
+
+.marquee { position: relative; z-index: 2; overflow: hidden; border-top: 1px solid var(--ink); border-bottom: 1px solid var(--ink); background: var(--signal); color: var(--ink); }
+.marquee-track { display: flex; width: max-content; animation: marquee 28s linear infinite; }
+.marquee-set { display: flex; flex-shrink: 0; }
+.marquee-item { height: 61px; display: flex; align-items: center; gap: 14px; padding: 0 31px; border-right: 1px solid var(--ink); font-family: Impact, Haettenschweiler, "Arial Narrow Bold", sans-serif; font-size: 23px; text-transform: uppercase; letter-spacing: -.02em; }
+.marquee-number { align-self: flex-start; padding-top: 11px; font-family: "Courier New", monospace; font-size: 7px; font-weight: 700; }
+.marquee-mark { font-family: Georgia, serif; font-size: 15px; }
+.reveal { opacity: 0; animation: reveal .75s cubic-bezier(.2,.75,.2,1) forwards; }
+.reveal-one { animation-delay: .08s; } .reveal-two { animation-delay: .2s; } .reveal-three { animation-delay: .36s; }
+
+@keyframes reveal { from { opacity: 0; transform: translateY(24px); } to { opacity: 1; transform: translateY(0); } }
+@keyframes marquee { to { transform: translateX(-50%); } }
+@keyframes rotate { to { transform: rotate(360deg); } }
+@keyframes pulse { 0% { box-shadow: 0 0 0 0 rgba(240,68,36,.7); } 70%, 100% { box-shadow: 0 0 0 7px rgba(240,68,36,0); } }
 
-body {
-  background: var(--background);
-  color: var(--foreground);
