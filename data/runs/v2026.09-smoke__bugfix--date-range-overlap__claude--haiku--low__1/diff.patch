     });
     expect(days).toEqual([]);
   });
+
+  test("preserves times correctly across DST transitions", () => {
+    const days = expandDailyRecurrence({
+      startDate: new Date(2026, 2, 7), // Mar 7, 2026 - before spring-forward DST
+      startHour: 9,
+      startMinute: 0,
+      endHour: 17,
+      endMinute: 0,
+      days: 5, // Mar 7-11, spanning the DST change on Mar 8
+    });
+
+    expect(days).toHaveLength(5);
+    for (let i = 0; i < days.length; i++) {
+      expect(days[i].start.getHours()).toBe(9);
+      expect(days[i].start.getMinutes()).toBe(0);
+      expect(days[i].end.getHours()).toBe(17);
+      expect(days[i].end.getMinutes()).toBe(0);
+      // Each day should be 8 hours (28800000 ms)
+      expect(days[i].end.getTime() - days[i].start.getTime()).toBe(8 * 60 * 60 * 1000);
+    }
+  });
