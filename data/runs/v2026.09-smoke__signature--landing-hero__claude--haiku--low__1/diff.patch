+export function StatusPill() {
+  const isLive = true;
+
+  return (
+    <div className="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-foreground/20 text-sm font-medium">
+      <div
+        className={`w-2 h-2 rounded-full ${
+          isLive
+            ? 'bg-red-500 animate-pulse'
+            : 'bg-foreground/40'
+        }`}
+      />
+      <span className="text-foreground/80">
+        {isLive ? 'Live now' : 'Offline'}
+      </span>
+    </div>
+  );
+}
