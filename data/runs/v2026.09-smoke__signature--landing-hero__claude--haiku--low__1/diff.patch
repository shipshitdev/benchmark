--- /dev/null
+++ b/components/Marquee.tsx
@@ -0,0 +1,56 @@
+'use client';
+
+export function Marquee() {
+  const tools = [
+    'Prism Flow',
+    'CodeStream',
+    'DevZone CLI',
+    'BuildKit Pro',
+    'DebugNinja',
+    'StreamDev',
+  ];
+
+  return (
+    <div className="relative w-full overflow-hidden bg-gradient-to-r from-transparent via-current to-transparent">
+      <style>{`
+        @keyframes marquee {
+          from {
+            transform: translateX(0);
+          }
+          to {
+            transform: translateX(-50%);
+          }
+        }
+        .marquee-content {
+          animation: marquee 20s linear infinite;
+        }
+        .marquee-content:hover {
+          animation-play-state: paused;
+        }
+      `}</style>
+
+      <div className="flex whitespace-nowrap py-6">
+        <div className="marquee-content flex gap-8 pr-8">
+          {tools.map((tool) => (
+            <div
+              key={tool}
+              className="text-lg font-medium text-foreground/70 hover:text-foreground transition-colors cursor-default"
+            >
+              {tool}
+            </div>
+          ))}
+        </div>
+        <div className="marquee-content flex gap-8 pr-8" aria-hidden="true">
+          {tools.map((tool) => (
+            <div
+              key={`${tool}-2`}
+              className="text-lg font-medium text-foreground/70 hover:text-foreground transition-colors cursor-default"
+            >
+              {tool}
+            </div>
+          ))}
+        </div>
+      </div>
+    </div>
+  );
+}
